# =========================================================================
# Helios MCP — przykładowe zmienne środowiskowe (BEZ prawdziwych sekretów).
#
# Skopiuj ten plik do `.env.local` na potrzeby pracy lokalnej,
# a w produkcji wpisz te same nazwy w:
#   Vercel → Project → Settings → Environment Variables
# Dodaj je do środowisk **Preview** oraz **Production**.
#
# NIGDY nie commituj prawdziwych wartości. `.env*` jest w `.gitignore`.
# =========================================================================

# Adres e-mail (Google), który JAKO JEDYNY ma dostęp do serwera.
# Każde inne konto zostaje odrzucone.
ALLOWED_EMAIL=ty@example.com

# Publiczny URL wdrożenia (bez ukośnika na końcu).
# Używany jako "issuer" OAuth i jako identyfikator zasobu.
# Lokalnie: http://localhost:3000 ; w produkcji: https://twoj-projekt.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# --- Google Apps Script (Helios Drive Adapter) ---
# URL wdrożonej aplikacji internetowej Apps Script (kończy się na /exec).
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Wspólny sekret HMAC. MUSI być identyczny z właściwością skryptu SHARED_SECRET.
# Wygeneruj np.: openssl rand -hex 32
APPS_SCRIPT_SECRET=zmien-mnie-losowy-ciag-min-32-znaki

# --- OAuth: nasz serwer autoryzacji ---
# Sekret do podpisu tokenów (JWT). Wygeneruj: openssl rand -hex 32
AUTH_SECRET=zmien-mnie-losowy-ciag-min-32-znaki

# --- Logowanie przez Google (upstream) ---
# Z Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# --- Opcjonalna allowlista redirect_uri klientów OAuth (obrona w głąb) ---
# Lista dokładnych redirect_uri (rozdzielona przecinkami), które wolno
# rejestrować przez Dynamic Client Registration i autoryzować w /oauth/authorize.
# Dopasowanie jest DOKŁADNE (bez wildcardów, bez dopasowania po hoście/prefiksie).
# Zostaw PUSTE/nieustawione, dopóki nie znasz DOKŁADNEGO redirect_uri, jaki
# faktycznie wyśle Twój klient MCP (Claude/ChatGPT) podczas rejestracji — nie
# zgaduj go z góry. Głównym mechanizmem obronnym przed nadużyciem otwartego
# DCR jest wtedy obowiązkowy ekran zgody na /oauth/authorize (zawsze pokazuje
# nazwę klienta i host redirect_uri przed zalogowaniem). Po odczytaniu
# rzeczywistego redirect_uri z logów/testu Preview, wklej go tutaj dokładnie
# (pełny URI, bez wildcardów) — format: rozdzielone przecinkami, np.:
# ALLOWED_OAUTH_REDIRECT_URIS=https://przyklad-klienta-a.example/cb,https://przyklad-klienta-b.example/callback
ALLOWED_OAUTH_REDIRECT_URIS=
